    given-names: "Zihe"
    orcid: "https://orcid.org/0009-0006-5228-5847"
repository-code: "https://github.com/Lu-Zihe/validity-gates-fault-injection"
license: MIT
keywords:
  - fault injection
  - silent failure
  - simulation validity
  - mutation testing
  - reproducible research
  - quadruped robot
